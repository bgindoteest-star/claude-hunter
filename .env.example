# Claude Invite Hunter - konfigurasi
# Isi token & chat id dari @BotFather, lalu chat id tujuan (bisa grup).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHECK_INTERVAL_MINUTES=30
# Channel Telegram publik yang dipindai (tanpa @, pisah koma).
# Contoh: TELEGRAM_CHANNELS=aipromos,freecoupons
TELEGRAM_CHANNELS=
# Query DuckDuckGo (default: dork invite/claim). Bisa dilebarkan bila nol hasil.
DDG_QUERY=
